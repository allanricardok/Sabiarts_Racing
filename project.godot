; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sabiarts_Racing"
run/main_scene="uid://ce2gdvomfunn8"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.14117648, 0.14117648, 0.23921569, 1)
boot_splash/image="uid://5nb636qn8jyl"
config/icon="uid://5nb636qn8jyl"

[autoload]

Global="*res://Core/Menus/Global.gd"
GameManager="*res://Core/game_manager.gd"
ScoreManager="*res://Autoload/ScoreManager.gd"
MissionManager="*res://Core/Objectives/MissionManager.gd"
SaveManager="*res://Autoload/SaveManager.gd"
GameStats="*res://Autoload/GameStats.gd"
